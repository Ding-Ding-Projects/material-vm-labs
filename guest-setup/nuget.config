<?xml version="1.0" encoding="utf-8"?>
<!-- A fresh SDK under a service account (the self-hosted runner) has no package source, so the
     self-contained publish cannot fetch its runtime packs. Name nuget.org here. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
