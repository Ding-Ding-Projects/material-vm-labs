<Window x:Class="MaterialVmLabsSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MaterialVmLabsSetup.ViewModels"
        xmlns:ctl="clr-namespace:MaterialVmLabsSetup.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Material VM Labs Setup" Width="1100" Height="720" MinWidth="760" MinHeight="600"
        WindowStyle="None" ResizeMode="CanResize" Background="{StaticResource Bg}" Foreground="{StaticResource TextBrush}" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="30" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>

        <!-- Left list: one row per tool with a battery cell that fills from the bottom. -->
        <DataTemplate x:Key="ToolRow" DataType="{x:Type vm:ToolCell}">
            <Border CornerRadius="14" Background="{Binding RowBg}" Padding="10,8" Margin="0,0,0,8"
                    AutomationProperties.Name="{Binding AutomationName}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource TrackBrush}" ClipToBounds="True">
                        <Border Background="{Binding Color}" CornerRadius="10" VerticalAlignment="Stretch"
                                RenderTransformOrigin="0.5,1" Style="{StaticResource PulseStyle}">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleY="{Binding Fill, Mode=OneWay}"/>
                            </Border.RenderTransform>
                        </Border>
                    </Border>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="10,0" FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="2" Text="{Binding State}" Foreground="{Binding StateBrush}" FontFamily="{StaticResource MonoFont}"
                               FontSize="11" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="Frame" BorderBrush="{StaticResource CardLine}" BorderThickness="1">
        <Grid x:Name="RootGrid">

            <!-- ============ the working window ============ -->
            <Grid x:Name="MainGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Compact top strip, shown under 900 px width in place of the side panel. -->
                <Border x:Name="CompactBar" Grid.Row="0" Background="{StaticResource PanelBg}" Padding="20,36,20,12" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <Border CornerRadius="10" Background="#E8EEF0" BorderBrush="{StaticResource AccentBrush}" BorderThickness="0,0,0,3" Padding="12,6">
                            <TextBlock Text="{Binding Plate}" Foreground="#07090A" FontFamily="{StaticResource MonoFont}" FontWeight="Bold" FontSize="16" TextWrapping="NoWrap"/>
                        </Border>
                        <TextBlock Text="{Binding Overall, StringFormat={}{0}% charged}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="13"
                                   Margin="14,0,0,0" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                        <TextBlock Text="{Binding Created}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="12,0,0,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="SideCol" Width="300"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Charging bay: plate, overall ring, one row per tool. -->
                    <Border x:Name="SidePanel" Grid.Column="0" Background="{StaticResource PanelBg}" Padding="22,34,22,20">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Bottom" Margin="0,12,0,0" FontSize="11" Foreground="{StaticResource FaintBrush}" LineHeight="17"
                                       Text="Close Setup any time: the installs run in their own task and Setup picks up where they are."/>
                            <StackPanel>
                                <Border HorizontalAlignment="Left" CornerRadius="12" Background="#E8EEF0" Padding="16,10"
                                        BorderBrush="{StaticResource AccentBrush}" BorderThickness="0,0,0,5">
                                    <TextBlock Text="{Binding Plate}" Foreground="#07090A" FontFamily="{StaticResource MonoFont}" FontSize="22" FontWeight="Bold"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                </Border>

                                <Grid Margin="0,18,0,18">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid Width="120" Height="120" AutomationProperties.Name="{Binding OverallLabel}">
                                        <ctl:RingProgress Value="{Binding Overall, Mode=OneWay}" ProgressBrush="{StaticResource AccentBrush}"
                                                          TrackBrush="{StaticResource TrackBrush}" Thickness="12"/>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Overall, StringFormat={}{0}%}" FontFamily="{StaticResource DisplayFont}" FontSize="30"
                                                       FontWeight="ExtraBold" TextAlignment="Center" TextWrapping="NoWrap"/>
                                            <TextBlock Text="CHARGED" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" TextAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Charging your lab machine" FontFamily="{StaticResource DisplayFont}" FontSize="21"
                                                   FontWeight="ExtraBold" LineHeight="23"/>
                                        <TextBlock Text="{Binding Created}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Tools}" ItemTemplate="{StaticResource ToolRow}" Focusable="False"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <Grid x:Name="ContentHost" Grid.Column="1" Margin="44,38,44,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Visibility="{Binding BannerVisible, Converter={StaticResource B2V}}" Margin="0,0,0,14"
                                Background="#12262E" CornerRadius="16" Padding="16,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="↻" Foreground="{StaticResource InfoBrush}" FontFamily="Segoe UI Symbol" FontSize="20"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding BannerText}" Foreground="#BFEFFF" FontSize="14" Margin="12,0"
                                           VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
                                <Button Grid.Column="2" Content="Got it" Command="{Binding DismissCommand}" Height="36" MinWidth="36" FontSize="13"
                                        Padding="14,0" Style="{StaticResource Pill}" Background="#1B3A46" FontWeight="Normal"
                                        AutomationProperties.Name="Dismiss the resumed notice"/>
                            </Grid>
                        </Border>

                        <!-- Segmented step bar: done = accent, current = light, future = dark. -->
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Steps}" KeyboardNavigation.TabNavigation="Continue" Margin="0,0,-6,14"
                                      AutomationProperties.Name="Steps" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:StepItem}">
                                    <Button Style="{StaticResource BarButton}" Command="{Binding Pick}" Background="{Binding BarBrush}"
                                            AutomationProperties.Name="{Binding AutomationName}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <StackPanel x:Name="PageHost" Margin="0,0,6,8">
                                <StackPanel.RenderTransform><TranslateTransform x:Name="PageShift"/></StackPanel.RenderTransform>

                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <ctl:OutlineText Text="{Binding StepNumber, Mode=OneWay}" FontSize="110" Stroke="{StaticResource AccentBrush}" StrokeThickness="2"
                                                     VerticalAlignment="Top" Margin="0,2,22,0"/>
                                    <StackPanel Grid.Column="1" Margin="0,6,0,0">
                                        <TextBlock Text="{Binding StepLabelUpper}" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="Bold"
                                                   AutomationProperties.LiveSetting="Polite"/>
                                        <TextBlock Text="{Binding PageTitle}" FontFamily="{StaticResource DisplayFont}" FontSize="44" FontWeight="ExtraBold"
                                                   Margin="0,6,0,8" LineHeight="46"/>
                                        <TextBlock Text="{Binding PageBody}" Foreground="{StaticResource BodyBrush}" FontSize="16" LineHeight="25"
                                                   MaxWidth="600" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Grid>

                                <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardLine}" BorderThickness="1"
                                        CornerRadius="26" Padding="22,16" Margin="0,20,0,0">
                                    <StackPanel>
                                        <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:RowItem}">
                                                    <Grid MinHeight="38">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Ellipse Width="12" Height="12" Fill="{Binding Dot}" VerticalAlignment="Center"
                                                                 Style="{StaticResource PulseStyle}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="15" Margin="14,0,12,0" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Value}" Foreground="{Binding ValueBrush}"
                                                                   FontFamily="{StaticResource MonoFont}" FontSize="13" TextAlignment="Right"
                                                                   MaxWidth="360" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ProgressBar Style="{StaticResource BarProgress}" Value="{Binding Progress, Mode=OneWay}"
                                                     Tag="{Binding Sweep, Mode=OneWay}" Margin="0,12,0,4"
                                                     Visibility="{Binding ShowProgress, Converter={StaticResource B2V}}"
                                                     AutomationProperties.Name="Install progress"/>
                                    </StackPanel>
                                </Border>

                                <ItemsControl ItemsSource="{Binding Actions}" Margin="0,20,0,0" KeyboardNavigation.TabNavigation="Continue">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ActionItem}">
                                            <Button Content="{Binding Label}" Command="{Binding Command}" Style="{StaticResource ActionButton}" Margin="0,0,10,10"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="{Binding Message}" Visibility="{Binding HasMessage, Converter={StaticResource B2V}}"
                                           Foreground="{StaticResource InfoBrush}" FontSize="13" Margin="0,2,0,6" MaxWidth="640" HorizontalAlignment="Left"
                                           AutomationProperties.LiveSetting="Polite"/>

                                <Grid Visibility="{Binding HasNote, Converter={StaticResource B2V}}" Margin="0,8,0,0" MaxWidth="640" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="ⓘ" Foreground="{StaticResource InfoBrush}" FontFamily="Segoe UI Symbol" FontSize="16"
                                               VerticalAlignment="Top"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Note}" Foreground="{StaticResource SoftBrush}" FontSize="13" LineHeight="20" Margin="10,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>

                        <Grid Grid.Row="3" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Back" Command="{Binding BackCommand}" Style="{StaticResource FooterButton}"/>
                            <Button Grid.Column="2" Content="Skip this step" Command="{Binding SkipCommand}" Style="{StaticResource GhostButton}" Margin="0,0,10,0"
                                    Visibility="{Binding CanSkip, Converter={StaticResource B2V}}"/>
                            <Button Grid.Column="3" Content="{Binding NextLabel}" Command="{Binding NextCommand}" Style="{StaticResource PrimaryFooterButton}"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>

            <!-- ============ takeovers: success and install failure ============ -->
            <Grid x:Name="OverlayLayer" Visibility="{Binding TakeoverVisible, Converter={StaticResource B2V}}"
                  AutomationProperties.LiveSetting="Assertive" AutomationProperties.Name="{Binding Takeover.Announcement}"
                  KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle">

                <!-- Install success -->
                <Grid x:Name="SuccessLayer" Background="#07090A" Visibility="{Binding IsTakeoverSuccess, Converter={StaticResource B2V}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="960" Margin="40,30">
                        <Grid Width="220" Height="220" HorizontalAlignment="Center">
                            <Ellipse x:Name="Ring1" Width="100" Height="100" Stroke="{StaticResource AccentBrush}" StrokeThickness="3"
                                     Opacity="0" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform><ScaleTransform x:Name="Ring1Scale" ScaleX="0.4" ScaleY="0.4"/></Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse x:Name="Ring2" Width="100" Height="100" Stroke="{StaticResource AccentBrush}" StrokeThickness="3"
                                     Opacity="0" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform><ScaleTransform x:Name="Ring2Scale" ScaleX="0.4" ScaleY="0.4"/></Ellipse.RenderTransform>
                            </Ellipse>
                            <Grid x:Name="SparkHost" HorizontalAlignment="Center" VerticalAlignment="Center" Width="10" Height="10"/>
                            <Border x:Name="Tile" Width="132" Height="132" CornerRadius="40" Background="{StaticResource AccentBrush}"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform><ScaleTransform x:Name="TileScale"/></Border.RenderTransform>
                                <Viewbox Width="70" Height="70">
                                    <Canvas Width="24" Height="24">
                                        <Path x:Name="BoltPath" Data="M13,2 L5,14 L11,14 L10,22 L18,10 L12,10 Z" Stroke="#07090A" StrokeThickness="2.6"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeDashArray="46 46"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>
                        </Grid>
                        <TextBlock Text="INSTALLED" Foreground="{StaticResource AccentBrush}" FontSize="13" FontWeight="Bold" TextAlignment="Center" Margin="0,14,0,0"/>
                        <TextBlock x:Name="ToolName" Text="{Binding Takeover.Headline}" FontFamily="{StaticResource DisplayFont}" FontSize="60" FontWeight="ExtraBold"
                                   TextAlignment="Center" Margin="0,8,0,14" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform><ScaleTransform x:Name="ToolScale"/></TextBlock.RenderTransform>
                        </TextBlock>
                        <WrapPanel HorizontalAlignment="Center">
                            <Border Background="#11181B" CornerRadius="12" Padding="14,8" Margin="5"
                                    Visibility="{Binding Takeover.HasVersion, Converter={StaticResource B2V}}">
                                <TextBlock Text="{Binding Takeover.Version}" FontFamily="{StaticResource MonoFont}" FontSize="14" TextWrapping="NoWrap"/>
                            </Border>
                            <Border Background="#11181B" CornerRadius="12" Padding="14,8" Margin="5">
                                <TextBlock Text="{Binding Takeover.Command}" FontFamily="{StaticResource MonoFont}" FontSize="14" TextWrapping="NoWrap"/>
                            </Border>
                            <Border Background="#11181B" CornerRadius="12" Padding="14,8" Margin="5">
                                <TextBlock Text="exit 0" FontFamily="{StaticResource MonoFont}" FontSize="14" TextWrapping="NoWrap"/>
                            </Border>
                        </WrapPanel>
                        <TextBlock Text="{Binding Takeover.Summary}" Foreground="{StaticResource SoftBrush}" FontSize="15" TextAlignment="Center" Margin="0,14,0,20"/>
                        <Button x:Name="KeepGoingButton" Content="Keep going" Command="{Binding DismissTakeoverCommand}" Style="{StaticResource Pill}"
                                Height="52" Padding="30,0" FontWeight="ExtraBold" Background="{StaticResource AccentBrush}" Foreground="#07090A"
                                HorizontalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Closes by itself in 6 s, or press Esc." Foreground="{StaticResource FaintBrush}" FontSize="12"
                               HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18"/>
                </Grid>

                <!-- Install failure: stays until the person chooses -->
                <Grid x:Name="AlarmLayer" Background="#0B0606" Visibility="{Binding IsTakeoverAlarm, Converter={StaticResource B2V}}" ClipToBounds="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Ellipse x:Name="Beacon" Grid.RowSpan="2" Width="420" Height="420" Fill="#FF5A47" Opacity="0.25"
                             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-140,-140,0" IsHitTestVisible="False">
                        <Ellipse.Effect><BlurEffect Radius="60"/></Ellipse.Effect>
                    </Ellipse>
                    <Border Grid.Row="0">
                        <Border.Background>
                            <DrawingBrush TileMode="Tile" Viewport="0,0,56,18" ViewportUnits="Absolute" Viewbox="0,0,56,18" ViewboxUnits="Absolute">
                                <DrawingBrush.Transform><TranslateTransform x:Name="TapeShift"/></DrawingBrush.Transform>
                                <DrawingBrush.Drawing>
                                    <DrawingGroup>
                                        <GeometryDrawing Brush="#0B0606" Geometry="M0,0 L56,0 L56,18 L0,18 Z"/>
                                        <GeometryDrawing Brush="#FF5A47"
                                                         Geometry="M-28,18 L-10,0 L4,0 L-14,18 Z M0,18 L18,0 L32,0 L14,18 Z M28,18 L46,0 L60,0 L42,18 Z M56,18 L74,0 L88,0 L70,18 Z"/>
                                    </DrawingGroup>
                                </DrawingBrush.Drawing>
                            </DrawingBrush>
                        </Border.Background>
                    </Border>
                    <Grid Grid.Row="1" Margin="54,30,54,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DockPanel x:Name="AlarmHeader" Grid.Row="0" LastChildFill="True" Margin="0,0,110,0">
                            <DockPanel.RenderTransform><TranslateTransform x:Name="AlarmShake"/></DockPanel.RenderTransform>
                            <Border DockPanel.Dock="Left" Width="70" Height="70" CornerRadius="22" Background="{StaticResource AlarmBrush}" VerticalAlignment="Top">
                                <Viewbox Width="38" Height="38">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M12,3 L2,21 L22,21 Z M12,10 L12,15 M12,18 L12.01,18" Stroke="#0B0606" StrokeThickness="2.6"
                                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="PROBLEM · INSTALL STOPPED" Foreground="{StaticResource BadBrush}" FontSize="13" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Takeover.Headline}" Foreground="#F4E8E6" FontFamily="{StaticResource DisplayFont}" FontSize="48"
                                           FontWeight="ExtraBold" LineHeight="50" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>

                        <UniformGrid Grid.Row="1" Columns="2" Margin="0,18,-14,0">
                            <Border CornerRadius="20" Background="#170D0C" Padding="18,14" Margin="0,0,14,0">
                                <StackPanel>
                                    <TextBlock Text="Failing step" Foreground="#C9A9A4" FontSize="12"/>
                                    <TextBlock Text="{Binding Takeover.Command}" Foreground="#F4E8E6" FontFamily="{StaticResource MonoFont}" FontSize="15" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border CornerRadius="20" Background="#170D0C" Padding="18,14" Margin="0,0,14,0">
                                <StackPanel>
                                    <TextBlock Text="What Setup recorded" Foreground="#C9A9A4" FontSize="12"/>
                                    <TextBlock Text="{Binding Takeover.Detail}" Foreground="#F4E8E6" FontFamily="{StaticResource MonoFont}" FontSize="14" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Grid.Row="2" CornerRadius="20" Background="#050303" Padding="20,16" Margin="0,16,0,16">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                <TextBlock Text="{Binding Takeover.Log}" Foreground="#E8D8D5" FontFamily="{StaticResource MonoFont}" FontSize="13" LineHeight="22"
                                           AutomationProperties.Name="Last lines of the install log"/>
                            </ScrollViewer>
                        </Border>

                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="RetryButton" Grid.Column="0" Content="Retry the install" Command="{Binding RetryTakeoverCommand}" Style="{StaticResource Pill}"
                                    Height="54" Padding="28,0" FontWeight="ExtraBold" Background="{StaticResource AlarmBrush}" Foreground="#0B0606" Margin="0,0,10,0"/>
                            <Button Grid.Column="1" Content="Open the full log" Command="{Binding OpenLogCommand}" Style="{StaticResource Pill}"
                                    Height="54" Padding="22,0" Background="#1E1211" Foreground="#F4E8E6"/>
                            <Button Grid.Column="3" Content="Dismiss" Command="{Binding DismissTakeoverCommand}" Style="{StaticResource Pill}"
                                    Height="54" Padding="22,0" FontWeight="Normal" Background="Transparent" Foreground="#C9A9A4"/>
                        </Grid>
                        <TextBlock Grid.Row="4" Text="Stays until you choose. The other installs keep running." Foreground="#8A6E6A" FontSize="12" Margin="0,10,0,0"/>
                    </Grid>
                </Grid>
            </Grid>

            <!-- ============ own window buttons (always on top; the strip above is the drag area) ============ -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,12,0" Panel.ZIndex="20">
                <Button x:Name="MinButton" Style="{StaticResource WinButton}" Margin="0,0,8,0" Click="OnMinimize"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Minimize">
                    <Viewbox Width="12" Height="12">
                        <Canvas Width="24" Height="24"><Path Data="M5,12 L19,12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                              StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas>
                    </Viewbox>
                </Button>
                <Button x:Name="MaxButton" Style="{StaticResource WinButton}" Margin="0,0,8,0" Click="OnMaximize"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Maximize">
                    <Viewbox Width="11" Height="11">
                        <Canvas Width="24" Height="24"><Path x:Name="MaxIcon" Data="M8,5 L16,5 Q19,5 19,8 L19,16 Q19,19 16,19 L8,19 Q5,19 5,16 L5,8 Q5,5 8,5 Z"
                                                             Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2.4"/></Canvas>
                    </Viewbox>
                </Button>
                <Button x:Name="CloseButton" Style="{StaticResource WinCloseButton}" Click="OnCloseWindow"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Close Setup">
                    <Viewbox Width="12" Height="12">
                        <Canvas Width="24" Height="24"><Path Data="M6,6 L18,18 M18,6 L6,18" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                              StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas>
                    </Viewbox>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
