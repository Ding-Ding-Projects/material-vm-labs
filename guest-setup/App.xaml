<Application x:Class="MaterialVmLabsSetup.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- Material 3 baseline dark scheme (seed #6750A4). -->
        <SolidColorBrush x:Key="Surface" Color="#141316"/>
        <SolidColorBrush x:Key="SurfaceContainerLowest" Color="#0F0E11"/>
        <SolidColorBrush x:Key="SurfaceContainerLow" Color="#1C1B1E"/>
        <SolidColorBrush x:Key="SurfaceContainer" Color="#201F22"/>
        <SolidColorBrush x:Key="SurfaceContainerHigh" Color="#2B292D"/>
        <SolidColorBrush x:Key="SurfaceContainerHighest" Color="#363438"/>
        <SolidColorBrush x:Key="OnSurface" Color="#E6E1E6"/>
        <SolidColorBrush x:Key="OnSurfaceVariant" Color="#CAC4CF"/>
        <SolidColorBrush x:Key="Outline" Color="#948F99"/>
        <SolidColorBrush x:Key="OutlineVariant" Color="#49454E"/>
        <SolidColorBrush x:Key="Primary" Color="#CFBCFF"/>
        <SolidColorBrush x:Key="OnPrimary" Color="#381E72"/>
        <SolidColorBrush x:Key="PrimaryContainer" Color="#4F378A"/>
        <SolidColorBrush x:Key="OnPrimaryContainer" Color="#E9DDFF"/>
        <SolidColorBrush x:Key="Secondary" Color="#CCC2DC"/>
        <SolidColorBrush x:Key="SecondaryContainer" Color="#4A4458"/>
        <SolidColorBrush x:Key="OnSecondaryContainer" Color="#E8DEF8"/>
        <SolidColorBrush x:Key="Error" Color="#FFB4AB"/>
        <SolidColorBrush x:Key="OnError" Color="#690005"/>
        <SolidColorBrush x:Key="ErrorContainer" Color="#93000A"/>
        <SolidColorBrush x:Key="OnErrorContainer" Color="#FFB4AB"/>
        <SolidColorBrush x:Key="Success" Color="#96D68F"/>
        <SolidColorBrush x:Key="SuccessContainer" Color="#12521A"/>
        <!-- Focus indicator: Material 3 uses the secondary role for the focus ring. -->
        <SolidColorBrush x:Key="FocusRing" Color="#CCC2DC"/>

        <!-- Roboto Flex is not bundled with WPF; Segoe UI Variable is the closest system face. -->
        <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
        <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
        <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

        <!-- No Foreground here: an implicit TextBlock style also reaches the labels inside buttons and
             would override each button's content colour. The window sets the default colour instead. -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Soft pulse while running: opacity 1 -> 0.5 -> 1. The Pulse flag is already false when reduced motion is on. -->
        <Style x:Key="PulseStyle" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Pulse}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="PulseSb">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.5"
                                                 Duration="0:0:0.8" AutoReverse="True" RepeatBehavior="Forever">
                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <RemoveStoryboard BeginStoryboardName="PulseSb"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Material 3 common button: 40 px high, fully rounded, a state layer in the content colour
             (8 % hover, 12 % pressed), a 3 px focus ring outside the container, 38 % when disabled.
             Enter and Space activate natively. This base is the tonal button. -->
        <Style x:Key="M3Button" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="48"/>
            <Setter Property="Padding" Value="24,0"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{StaticResource SecondaryContainer}"/>
            <Setter Property="Foreground" Value="{StaticResource OnSecondaryContainer}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Focus" Margin="-4" CornerRadius="24" BorderThickness="3" BorderBrush="Transparent" IsHitTestVisible="False"/>
                            <Border x:Name="Bd" CornerRadius="20" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid>
                                    <Border x:Name="StateLayer" CornerRadius="20" Background="{TemplateBinding Foreground}" Opacity="0" IsHitTestVisible="False"/>
                                    <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Focus" Property="BorderBrush" Value="{StaticResource FocusRing}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="StateLayer" Property="Opacity" Value="0.08"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="StateLayer" Property="Opacity" Value="0.12"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TonalButton" TargetType="Button" BasedOn="{StaticResource M3Button}"/>

        <Style x:Key="FilledButton" TargetType="Button" BasedOn="{StaticResource M3Button}">
            <Setter Property="Background" Value="{StaticResource Primary}"/>
            <Setter Property="Foreground" Value="{StaticResource OnPrimary}"/>
        </Style>

        <Style x:Key="OutlinedButton" TargetType="Button" BasedOn="{StaticResource M3Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Primary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Outline}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="TextButton" TargetType="Button" BasedOn="{StaticResource M3Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Primary}"/>
            <Setter Property="Padding" Value="12,0"/>
        </Style>

        <Style x:Key="ErrorFilledButton" TargetType="Button" BasedOn="{StaticResource M3Button}">
            <Setter Property="Background" Value="{StaticResource Error}"/>
            <Setter Property="Foreground" Value="{StaticResource OnError}"/>
        </Style>

        <!-- Page actions: filled when primary, tonal otherwise. -->
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource M3Button}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Primary}"/>
                    <Setter Property="Foreground" Value="{StaticResource OnPrimary}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Window caption buttons drawn by the app (the system title strip is gone): Material 3 standard icon buttons. -->
        <Style x:Key="WinButton" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource OnSurfaceVariant}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="14" Background="{TemplateBinding Background}"
                                BorderThickness="2" BorderBrush="Transparent">
                            <Grid>
                                <Border x:Name="StateLayer" CornerRadius="12" Background="{TemplateBinding Foreground}" Opacity="0" IsHitTestVisible="False"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource FocusRing}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="StateLayer" Property="Opacity" Value="0.08"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="StateLayer" Property="Opacity" Value="0.12"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WinCloseButton" TargetType="Button" BasedOn="{StaticResource WinButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource ErrorContainer}"/>
                    <Setter Property="Foreground" Value="{StaticResource OnErrorContainer}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Stepper segment: a 4 px track, a numbered or checked marker and the step title.
             The whole segment is one button with a focus ring and a state layer. -->
        <Style x:Key="StepButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{StaticResource OnSurfaceVariant}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Ring" CornerRadius="12" BorderThickness="2" BorderBrush="Transparent" Margin="0,0,6,0" Background="Transparent">
                            <Grid>
                                <Border x:Name="StateLayer" CornerRadius="10" Background="{StaticResource OnSurface}" Opacity="0" IsHitTestVisible="False"/>
                                <ContentPresenter Margin="6"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource FocusRing}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="StateLayer" Property="Opacity" Value="0.08"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="StateLayer" Property="Opacity" Value="0.12"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Material 3 linear progress: 4 px, rounded, primary indicator on a secondary-container track
             with a stop dot at the end. While Tag is true (running, motion allowed) a soft highlight
             travels along the indicator. -->
        <Style x:Key="LinearProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="4"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border CornerRadius="2" Background="{StaticResource SecondaryContainer}"/>
                            <Ellipse Width="4" Height="4" HorizontalAlignment="Right" Fill="{StaticResource Primary}"/>
                            <Border x:Name="PART_Track" CornerRadius="2" ClipToBounds="True">
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="2"
                                        Background="{StaticResource Primary}" ClipToBounds="True">
                                    <Border x:Name="Highlight" Opacity="0" IsHitTestVisible="False">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0.4,0">
                                                <LinearGradientBrush.RelativeTransform>
                                                    <TranslateTransform x:Name="HighlightShift" X="-0.4"/>
                                                </LinearGradientBrush.RelativeTransform>
                                                <GradientStop Color="#00E9DDFF" Offset="0"/>
                                                <GradientStop Color="#80E9DDFF" Offset="0.5"/>
                                                <GradientStop Color="#00E9DDFF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                </Border>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                <Setter TargetName="Highlight" Property="Opacity" Value="1"/>
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="HighlightSb">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HighlightShift" Storyboard.TargetProperty="X"
                                                             From="-0.4" To="1.0" Duration="0:0:1.8" RepeatBehavior="Forever">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <RemoveStoryboard BeginStoryboardName="HighlightSb"/>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Label / value row used in the takeover details. -->
        <Style x:Key="DetailLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Application.Resources>
</Application>
