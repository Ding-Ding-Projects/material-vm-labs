<Application x:Class="MaterialVmLabsSetup.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <Color x:Key="BgC">#07090A</Color>
        <SolidColorBrush x:Key="Bg" Color="#07090A"/>
        <SolidColorBrush x:Key="PanelBg" Color="#0D1214"/>
        <SolidColorBrush x:Key="CardBg" Color="#0F1517"/>
        <SolidColorBrush x:Key="CardLine" Color="#1C2529"/>
        <SolidColorBrush x:Key="RaisedBg" Color="#151C1F"/>
        <SolidColorBrush x:Key="TrackBrush" Color="#1A2226"/>
        <SolidColorBrush x:Key="TextBrush" Color="#E8EEF0"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8FA0A6"/>
        <SolidColorBrush x:Key="FaintBrush" Color="#6B7A80"/>
        <SolidColorBrush x:Key="SoftBrush" Color="#A9B6BA"/>
        <SolidColorBrush x:Key="BodyBrush" Color="#C9D3D6"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#C6F432"/>
        <SolidColorBrush x:Key="InfoBrush" Color="#5FD4FF"/>
        <SolidColorBrush x:Key="BadBrush" Color="#FF8A7A"/>
        <SolidColorBrush x:Key="AlarmBrush" Color="#FF5A47"/>
        <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
        <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
        <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

        <!-- No Foreground here: an implicit TextBlock style also reaches the labels inside buttons and
             made dark-on-lime buttons light (seen 2026-11-19). The window sets the default colour instead. -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Pulse while running: opacity 1 -> 0.35 -> 1 every 1.1 s. The Pulse flag is already false when reduced motion is on. -->
        <Style x:Key="PulseStyle" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Pulse}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="PulseSb">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.35"
                                                 Duration="0:0:0.55" AutoReverse="True" RepeatBehavior="Forever"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <RemoveStoryboard BeginStoryboardName="PulseSb"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Pill button: visible keyboard focus ring (cyan), Enter/Space activate natively. -->
        <Style x:Key="Pill" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="MinWidth" Value="46"/>
            <Setter Property="Padding" Value="22,0"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{StaticResource RaisedBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="40" Background="{TemplateBinding Background}"
                                BorderThickness="3" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource InfoBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource Pill}">
            <Setter Property="Height" Value="52"/>
            <Setter Property="Padding" Value="24,0"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="#07090A"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FooterButton" TargetType="Button" BasedOn="{StaticResource Pill}">
            <Setter Property="Height" Value="46"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Padding" Value="20,0"/>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource FooterButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource SoftBrush}"/>
        </Style>

        <Style x:Key="PrimaryFooterButton" TargetType="Button" BasedOn="{StaticResource FooterButton}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#07090A"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="Padding" Value="26,0"/>
        </Style>

        <!-- Round window buttons drawn by the app (the system title strip is gone). -->
        <Style x:Key="WinButton" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#151C1F"/>
            <Setter Property="Foreground" Value="#A9B6BA"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="11" Background="{TemplateBinding Background}"
                                BorderThickness="2" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource InfoBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WinCloseButton" TargetType="Button" BasedOn="{StaticResource WinButton}">
            <Setter Property="Background" Value="#2A1416"/>
            <Setter Property="Foreground" Value="#FF8A7A"/>
        </Style>

        <!-- Segmented step bar: a thin pill inside a taller hit area with a keyboard focus ring. -->
        <Style x:Key="BarButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Ring" CornerRadius="9" BorderThickness="2" BorderBrush="Transparent" Padding="0,6" Margin="0,0,6,0"
                                Background="Transparent">
                            <Border Height="8" CornerRadius="4" Background="{TemplateBinding Background}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource InfoBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Progress bar with a lighter band that sweeps across the fill while Tag is true (running, motion allowed). -->
        <Style x:Key="BarProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="10"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border CornerRadius="5" Background="{StaticResource TrackBrush}"/>
                            <Border x:Name="PART_Track" CornerRadius="5" ClipToBounds="True">
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="5"
                                        Background="{StaticResource InfoBrush}" ClipToBounds="True">
                                    <Border x:Name="Sweep" Opacity="0" IsHitTestVisible="False">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0.4,0">
                                                <LinearGradientBrush.RelativeTransform>
                                                    <TranslateTransform x:Name="SweepShift" X="-0.4"/>
                                                </LinearGradientBrush.RelativeTransform>
                                                <GradientStop Color="#00BFEFFF" Offset="0"/>
                                                <GradientStop Color="#A0BFEFFF" Offset="0.5"/>
                                                <GradientStop Color="#00BFEFFF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                </Border>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                <Setter TargetName="Sweep" Property="Opacity" Value="1"/>
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="SweepSb">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SweepShift" Storyboard.TargetProperty="X"
                                                             From="-0.4" To="1.0" Duration="0:0:1.6" RepeatBehavior="Forever">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <RemoveStoryboard BeginStoryboardName="SweepSb"/>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
